<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 访问 Immich 服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      TV 特性声明。required 必须是 false：
      写成 true 时，Android 会把 App 当成「纯电视应用」，在手机上直接强制横向渲染
      （窗口 Requested w=2400 h=1080，而手机物理是 1080x2400 纵向），
      内容是横着的、点击坐标全错，完全没法用触屏操作。
      设成 false 后电视上仍然能正常安装运行（电视会声明这个特性），
      手机上则按普通应用处理，可竖屏、可触屏。
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- TV 桌面（LEANBACK_LAUNCHER）要求的 320x180 横幅 -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_round_launcher"
        android:banner="@drawable/ic_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ImmichTV">

        <!-- usesCleartextTraffic=true：本地局域网 HTTP 访问 Immich 需要；
             生产环境建议反代 HTTPS 后去掉 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TV 桌面入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
